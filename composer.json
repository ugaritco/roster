{
    "name": "ugarit/roster",
    "description": "Detect packages & approaches in use within a Ugarit project",
    "keywords": [
        "dev",
        "ugarit"
    ],
    "homepage": "https://github.com/ugarit/roster",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/roster/issues",
        "source": "https://github.com/ugarit/roster"
    },
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.0",
        "heritage/console": "^1.00.00",
        "heritage/contracts": "^1.00.00",
        "heritage/support": "^1.00.00",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "ugarit/pint": "^1.00.00",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.1",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Roster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Roster\\RosterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "pint",
            "rector"
        ],
        "test:lint": [
            "pint --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --ci",
        "test:types": "phpstan --no-progress",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:types"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "version": "1.00.00"
}
